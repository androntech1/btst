# Copy this file to `.env` and fill in your values.
# Real environment variables and CI secrets always override these (the loader uses setdefault).

# API key for the AI ranking step. Required only when AI_ENABLED=true and AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# Only needed when AI_PROVIDER=openai.
OPENAI_API_KEY=

# AI ranking layer: "true" (default) runs the LLM re-ranker; "false" runs rule-based only
# (no API key needed).
AI_ENABLED=true

# AI provider: "openrouter" (default) or "openai".
AI_PROVIDER=openrouter

# Model slug for the chosen provider.
AI_MODEL=google/gemini-2.5-flash
